---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const cols = [
  { title: 'Pipelines', links: [['Browse all', '/pipelines'], ['Propose a pipeline', '/contribute#pipelines'], ['Documentation', '/documentation']] },
  { title: 'Community', links: [['Get involved', '/community'], ['Contribute', '/contribute'], ['Research', '/research']] },
  { title: 'Bioxflow', links: [['About', '/about'], ['Contact', '/contact']] }
];
---
<footer class="flow-lines bg-ink text-slate-400">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <Logo tone="dark" size={36} />
      <p class="mt-4 max-w-xs text-sm leading-6">
        An open community building reproducible bioinformatics pipelines — from raw reads to results.
      </p>
    </div>
    {cols.map((c) => (
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-300">{c.title}</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {c.links.map(([label, href]) => (
            <li><a href={href} class="transition hover:text-flow">{label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs sm:px-6">© {year} Bioxflow · bioxflow.co.uk</p>
  </div>
</footer>
