---
import type { Pipeline } from '../data/pipelines';
interface Props { pipeline: Pipeline }
const { pipeline: p } = Astro.props;
const badge = {
  Released: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  'In development': 'bg-amber-50 text-amber-800 ring-amber-200',
  Planned: 'bg-slate-100 text-slate-600 ring-slate-200'
}[p.status];
const search = [p.slug, p.title, p.category, p.description, ...p.tags, ...p.tools].join(' ').toLowerCase();
---
<article
  class="pipeline-card group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition duration-200 hover:-translate-y-0.5 hover:border-flow hover:shadow-[0_12px_40px_-12px_rgb(14_27_43/0.25)]"
  data-search={search}
  data-category={p.category}
  data-status={p.status}
>
  <div class="flex items-start justify-between gap-3">
    <p class="font-mono text-[0.95rem] font-medium text-ink">
      <span class="text-slate-400">bioxflow/</span>{p.slug}
    </p>
    <span class={`shrink-0 rounded-full px-2.5 py-1 text-[0.7rem] font-semibold ring-1 ${badge}`}>{p.status}</span>
  </div>

  <h3 class="mt-3 text-xl font-semibold text-ink">{p.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{p.description}</p>

  <div class="mt-5 flex flex-wrap gap-1.5">
    {p.tags.map((t) => (
      <span class="rounded-md bg-flow-soft px-2 py-1 font-mono text-[0.72rem] text-flow-dark">{t}</span>
    ))}
  </div>

  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500">
    <span class="truncate">{p.tools.join(' · ')}</span>
    <span class="ml-3 shrink-0 rounded border border-slate-200 px-1.5 py-0.5 font-medium text-slate-600">{p.engine}</span>
  </div>
</article>
