---
import Logo from './Logo.astro';

const links = [
  { href: '/pipelines', label: 'Pipelines' },
  { href: '/documentation', label: 'Docs' },
  { href: '/contribute', label: 'Contribute' },
  { href: '/community', label: 'Community' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' }
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3.5 sm:px-6">
    <a href="/" aria-label="Bioxflow home"><Logo size={34} /></a>

    <div class="hidden items-center gap-1 text-[0.95rem] font-medium lg:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class={`rounded-md px-3 py-2 transition ${isActive(l.href) ? 'bg-flow-soft text-flow-dark' : 'text-slate-600 hover:bg-slate-100 hover:text-ink'}`}
        >{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a href="/pipelines#search" class="hidden items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-500 transition hover:border-flow hover:text-ink md:flex">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        Search pipelines
      </a>
      <a href="/contribute" class="hidden rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-flow-dark sm:inline-flex">
        Build a pipeline
      </a>

      <details class="group relative lg:hidden">
        <summary class="flex cursor-pointer list-none items-center rounded-lg border border-slate-200 p-2 text-ink [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
          {links.map((l) => (
            <a href={l.href} class={`block rounded-md px-3 py-2 text-sm font-medium ${isActive(l.href) ? 'bg-flow-soft text-flow-dark' : 'text-slate-700 hover:bg-slate-100'}`}>{l.label}</a>
          ))}
          <a href="/contact" class="block rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Contact</a>
        </div>
      </details>
    </div>
  </nav>
</header>
