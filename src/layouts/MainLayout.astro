
---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bioxflow | Bioinformatics and Computational Biology',
  description = 'Open bioinformatics pipelines, genomic analysis and computational biology resources.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101c2c" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
