---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Page not found | Bioxflow" description="This page could not be found.">
  <main class="bg-paper px-4 py-28 text-center sm:px-6">
    <p class="font-mono text-sm font-medium text-flow-dark">404</p>
    <h1 class="mt-3 text-4xl font-bold text-ink">Page not found</h1>
    <p class="mt-4 text-slate-600">The page may have moved, or the link may be wrong.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-ink px-6 py-3.5 font-semibold text-white transition hover:bg-flow-dark">Go home</a>
      <a href="/pipelines" class="rounded-lg border border-slate-300 bg-white px-6 py-3.5 font-semibold text-ink transition hover:border-flow">Browse pipelines</a>
    </div>
  </main>
</MainLayout>
