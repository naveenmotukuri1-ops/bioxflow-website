---
import MainLayout from '../layouts/MainLayout.astro';
import PipelineCard from '../components/PipelineCard.astro';
import { pipelines, categories } from '../data/pipelines';

const statuses = ['Released', 'In development', 'Planned'];
---

<MainLayout
  title="Pipelines | Bioxflow"
  description="Browse community-built bioinformatics pipelines for genomics, transcriptomics, single-cell, microbial genomics and metagenomics."
>
  <main class="bg-paper">
    <section class="flow-bg relative overflow-hidden bg-ink text-white">
      <div class="flow-lines absolute inset-0 opacity-70"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-flow">Catalogue</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Pipelines</h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">
          Reproducible analysis pipelines developed and reviewed by the Bioxflow community.
        </p>
        <label id="search" class="mt-8 flex max-w-2xl items-center gap-3 rounded-xl bg-white px-4 py-3.5 text-ink shadow-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="text-slate-400"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="sr-only">Search pipelines</span>
          <input id="pipeline-search" type="search" placeholder="Search by name, tool or topic — e.g. rna-seq, GATK, amr" class="w-full bg-transparent outline-none placeholder:text-slate-400" />
        </label>
      </div>
    </section>

    <section class="px-4 py-10 sm:px-6">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-center gap-2" id="category-filters">
          <button data-cat="all" class="cat-btn rounded-full border px-3.5 py-1.5 text-sm font-medium transition">All</button>
          {categories.map((c) => (
            <button data-cat={c} class="cat-btn rounded-full border px-3.5 py-1.5 text-sm font-medium transition">{c}</button>
          ))}
          <select id="status-filter" class="ml-auto rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" aria-label="Filter by status">
            <option value="all">Any status</option>
            {statuses.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <p id="result-count" class="mt-6 text-sm text-slate-500" aria-live="polite"></p>

        <div id="pipeline-grid" class="mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {pipelines.map((p) => <PipelineCard pipeline={p} />)}
        </div>

        <div id="empty-state" class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
          <p class="font-semibold text-ink">No pipelines match your search.</p>
          <p class="mt-2 text-sm text-slate-600">Can't find what you need? <a href="/contribute#pipelines" class="font-semibold text-flow-dark hover:underline">Propose a new pipeline →</a></p>
        </div>
      </div>
    </section>

    <section class="px-4 pb-20 sm:px-6">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 rounded-2xl border border-slate-200 bg-white p-8 md:flex-row md:items-center">
        <div>
          <h2 class="text-2xl font-bold text-ink">Missing a pipeline?</h2>
          <p class="mt-2 text-slate-600">Propose it to the community and build it with the Bioxflow template.</p>
        </div>
        <a href="/contribute#pipelines" class="rounded-lg bg-ink px-6 py-3.5 font-semibold text-white transition hover:bg-flow-dark">Propose a pipeline →</a>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const search = document.getElementById('pipeline-search') as HTMLInputElement;
  const status = document.getElementById('status-filter') as HTMLSelectElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.cat-btn')];
  const cards = [...document.querySelectorAll<HTMLElement>('.pipeline-card')];
  const count = document.getElementById('result-count')!;
  const empty = document.getElementById('empty-state')!;
  let cat = 'all';

  const on = 'border-ink bg-ink text-white';
  const off = 'border-slate-300 bg-white text-slate-700 hover:border-flow';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok = (!q || c.dataset.search!.includes(q))
        && (cat === 'all' || c.dataset.category === cat)
        && (status.value === 'all' || c.dataset.status === status.value);
      c.style.display = ok ? '' : 'none';
      if (ok) shown++;
    }
    for (const b of buttons) {
      const active = b.dataset.cat === cat;
      b.className = b.className.replace(on, '').replace(off, '').trim() + ' ' + (active ? on : off);
      b.setAttribute('aria-pressed', String(active));
    }
    count.textContent = `${shown} of ${cards.length} pipelines`;
    empty.classList.toggle('hidden', shown > 0);
  }

  buttons.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat!; apply(); }));
  search.addEventListener('input', apply);
  status.addEventListener('change', apply);
  if (location.hash === '#search') search.focus();
  apply();
</script>
