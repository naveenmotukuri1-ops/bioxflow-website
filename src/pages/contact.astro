
---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';

const enquiryTypes = [
  'General enquiry',
  'Pipeline development',
  'Research collaboration',
  'Bioinformatics support',
  'Open-source contribution',
  'Education and learning',
  'Other'
];
---

<MainLayout
  title="Contact | Bioxflow"
  description="Contact Bioxflow for research collaboration, bioinformatics development, open-source contributions and general enquiries."
>
  <Navbar />

  <main class="overflow-hidden bg-white">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-[#101c2c] px-6 py-24 text-white lg:py-32">
      <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full border border-teal-400/10"></div>
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full border border-teal-400/10"></div>
      <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-teal-500/10 blur-3xl"></div>

      <div class="relative mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-teal-400/30 bg-teal-400/10 px-4 py-2 text-sm font-medium text-teal-300">
            <span class="h-2 w-2 rounded-full bg-teal-400"></span>
            Let's connect
          </span>

          <h1 class="text-5xl font-bold leading-tight tracking-tight md:text-7xl">
            Have an idea?
            <span class="block text-[#18b6a4]">Let's explore it.</span>
          </h1>

          <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
            Whether you're interested in bioinformatics, research collaboration,
            computational biology or contributing to open science, we'd love to
            hear from you.
          </p>

          <div class="mt-10 flex flex-wrap gap-3 text-sm text-slate-300">
            <span class="rounded-lg border border-white/10 px-4 py-2">Research</span>
            <span class="rounded-lg border border-white/10 px-4 py-2">Bioinformatics</span>
            <span class="rounded-lg border border-white/10 px-4 py-2">Collaboration</span>
            <span class="rounded-lg border border-white/10 px-4 py-2">Community</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT CONTENT -->
    <section class="px-6 py-20 lg:py-28">
      <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-[0.8fr_1.2fr]">

        <!-- LEFT INFORMATION -->
        <div>
          <span class="text-sm font-bold uppercase tracking-[0.2em] text-[#159d90]">
            Get in touch
          </span>

          <h2 class="mt-5 text-4xl font-bold leading-tight text-[#101c2c]">
            Let's start a conversation.
          </h2>

          <p class="mt-6 leading-8 text-slate-600">
            Bioxflow aims to bring together researchers, developers and
            students interested in using computational approaches to
            understand biological questions.
          </p>

          <p class="mt-4 leading-8 text-slate-600">
            Send us an enquiry using the form. Please include enough detail
            for us to understand what you're looking to discuss.
          </p>

          <!-- ENQUIRY CARDS -->
          <div class="mt-12 space-y-5">

            <div class="flex gap-5 rounded-2xl border border-slate-200 p-5 transition hover:border-teal-300">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-xl text-teal-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                  <path d="M4 5h16v14H4z"/>
                  <path d="m4 7 8 6 8-6"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-[#101c2c]">General enquiries</h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  Questions about Bioxflow, its vision and planned activities.
                </p>
              </div>
            </div>

            <div class="flex gap-5 rounded-2xl border border-slate-200 p-5 transition hover:border-teal-300">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-xl text-teal-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-[#101c2c]">Research collaboration</h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  Discuss research ideas, computational methods and potential collaborations.
                </p>
              </div>
            </div>

            <div class="flex gap-5 rounded-2xl border border-slate-200 p-5 transition hover:border-teal-300">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-xl text-teal-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                  <path d="M8 6h13M8 12h13M8 18h13"/>
                  <path d="M3 6h.01M3 12h.01M3 18h.01"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-[#101c2c]">Contribute to Bioxflow</h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                  Interested in contributing to workflows, documentation or community development?
                </p>
                <a href="/contribute" class="mt-3 inline-flex text-sm font-bold text-teal-700 hover:text-[#101c2c]">
                  Explore contribution opportunities →
                </a>
              </div>
            </div>

          </div>

          <div class="mt-10 rounded-2xl bg-[#f1f7f8] p-6">
            <p class="text-sm font-semibold text-[#101c2c]">Our approach</p>
            <p class="mt-2 text-sm leading-7 text-slate-600">
              Open collaboration, reproducible science and accessible
              computational biology are central to the Bioxflow vision.
            </p>
          </div>
        </div>

        <!-- CONTACT FORM -->
        <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-xl shadow-slate-200/50 md:p-10">
          <div class="mb-8">
            <span class="text-sm font-bold uppercase tracking-[0.2em] text-[#159d90]">
              Contact form
            </span>
            <h2 class="mt-3 text-3xl font-bold text-[#101c2c]">
              Send us a message
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">
              Complete the details below to prepare your enquiry.
            </p>
          </div>

          <form id="contact-form" class="space-y-6">

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">
                  Full name *
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  placeholder="Your full name"
                  required
                  autocomplete="name"
                  class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
                />
              </div>

              <div>
                <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">
                  Email address *
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="you@example.com"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
                />
              </div>
            </div>

            <div>
              <label for="organisation" class="mb-2 block text-sm font-semibold text-slate-700">
                Organisation / Institution
                <span class="font-normal text-slate-400">(Optional)</span>
              </label>
              <input
                id="organisation"
                name="organisation"
                type="text"
                placeholder="University, research institute or organisation"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
              />
            </div>

            <div>
              <label for="enquiry" class="mb-2 block text-sm font-semibold text-slate-700">
                Enquiry type *
              </label>
              <select
                id="enquiry"
                name="enquiry"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
              >
                <option value="">Select an enquiry type</option>
                {enquiryTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="subject" class="mb-2 block text-sm font-semibold text-slate-700">
                Subject *
              </label>
              <input
                id="subject"
                name="subject"
                type="text"
                placeholder="What would you like to discuss?"
                required
                class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
              />
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-semibold text-slate-700">
                Your message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                placeholder="Tell us a little about your enquiry..."
                required
                class="w-full resize-y rounded-xl border border-slate-300 bg-slate-50 px-4 py-3.5 text-sm outline-none transition focus:border-teal-500 focus:bg-white focus:ring-2 focus:ring-teal-100"
              ></textarea>
            </div>

            <p class="text-xs leading-6 text-slate-500">
              By submitting, your email application will open with your
              message prepared. You can review it before sending.
            </p>

            <button
              type="submit"
              class="flex w-full items-center justify-center gap-3 rounded-xl bg-[#101c2c] px-6 py-4 font-semibold text-white transition hover:bg-teal-700"
            >
              Prepare your message
              <span aria-hidden="true">→</span>
            </button>

            <p id="form-status" role="status" aria-live="polite" class="text-sm leading-6 text-slate-600"></p>

          </form>
        </div>

      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="bg-[#f3f8f9] px-6 py-20">
      <div class="mx-auto max-w-5xl text-center">
        <span class="text-sm font-bold uppercase tracking-[0.2em] text-teal-700">
          Be part of the journey
        </span>

        <h2 class="mt-5 text-3xl font-bold text-[#101c2c] md:text-5xl">
          Better science through better collaboration.
        </h2>

        <p class="mx-auto mt-6 max-w-2xl leading-8 text-slate-600">
          Explore the Bioxflow community and discover ways to contribute
          to an open and reproducible bioinformatics ecosystem.
        </p>

        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <a href="/community" class="rounded-xl bg-[#101c2c] px-7 py-4 font-semibold text-white transition hover:bg-teal-700">
            Explore community →
          </a>
          <a href="/contribute" class="rounded-xl border border-slate-300 bg-white px-7 py-4 font-semibold text-[#101c2c] transition hover:border-teal-500">
            Get involved
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-[#101c2c] px-6 py-10 text-center text-sm text-slate-400">
    <p>
      © {new Date().getFullYear()} Bioxflow. Building an open bioinformatics ecosystem.
    </p>
    <a href="/" class="mt-3 inline-block text-teal-400 hover:text-white">
      Back to home ↑
    </a>
  </footer>

</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');

  // Replace this with your actual contact email address.
  const contactEmail = 'YOUR_EMAIL_ADDRESS';

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    if (contactEmail === 'YOUR_EMAIL_ADDRESS') {
      if (status) {
        status.textContent =
          'The form is ready. Please configure your Bioxflow contact email address in the page code before using it.';
      }
      return;
    }

    const data = new FormData(form);

    const subject = String(data.get('subject') || '');
    const body = [
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      `Organisation: ${data.get('organisation') || 'Not provided'}`,
      `Enquiry type: ${data.get('enquiry')}`,
      '',
      'Message:',
      String(data.get('message') || '')
    ].join('\n');

    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (status) {
      status.textContent =
        'Your email application should open with the enquiry prepared. Review the message and send it from your email application.';
    }

    window.location.href = mailto;
  });

  // Preselect enquiry type when the page is opened with an interest parameter.
  const params = new URLSearchParams(window.location.search);
  const interest = params.get('interest');

  const enquirySelect = document.querySelector<HTMLSelectElement>('#enquiry');

  if (interest && enquirySelect) {
    const options = Array.from(enquirySelect.options);
    const matchingOption = options.find(
      (option) => option.value.toLowerCase() === interest.toLowerCase()
    );

    if (matchingOption) {
      enquirySelect.value = matchingOption.value;
    } else if (interest.toLowerCase() === 'contribution') {
      enquirySelect.value = 'Open-source contribution';
    }
  }
</script>
</MainLayout>
