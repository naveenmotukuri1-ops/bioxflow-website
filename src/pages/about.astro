---
import MainLayout from '../layouts/MainLayout.astro';
import Logo from '../components/Logo.astro';

const values = [
  ['Open by default', 'Code, documentation and discussions are public so anyone can learn from and improve them.'],
  ['Reproducible science', 'Pinned software environments and versioned releases make every analysis repeatable.'],
  ['Built together', 'Pipelines are proposed, developed and reviewed by the community, not a single lab.']
];
---
<MainLayout title="About | Bioxflow" description="Bioxflow is an open community developing reproducible bioinformatics pipelines.">
  <main>
    <section class="flow-bg relative overflow-hidden bg-ink text-white">
      <div class="flow-lines absolute inset-0 opacity-70"></div>
      <div class="relative mx-auto max-w-4xl px-4 py-20 sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-flow">About</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Making biological data analysis open and reproducible</h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Bioxflow brings together developers, researchers and students to build high-quality
          bioinformatics pipelines that anyone can run, inspect and improve.
        </p>
      </div>
    </section>

    <section class="px-4 py-20 sm:px-6">
      <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[auto_1fr]">
        <div class="flex justify-center rounded-3xl bg-paper p-10"><Logo size={140} withText={false} /></div>
        <div>
          <h2 class="text-3xl font-bold text-ink">The story behind the mark</h2>
          <p class="mt-4 leading-8 text-slate-600">
            Two DNA strands cross to form the <strong class="text-ink">x</strong> in Bioxflow, then merge into a single
            point. It stands for what a good pipeline does: many inputs and steps, flowing into one reliable result.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-paper px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-3xl font-bold text-ink">What we value</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {values.map(([title, text]) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6">
              <h3 class="text-lg font-semibold text-ink">{title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
            </div>
          ))}
        </div>
        <a href="/contribute" class="mt-10 inline-flex rounded-lg bg-ink px-6 py-3.5 font-semibold text-white transition hover:bg-flow-dark">Get involved →</a>
      </div>
    </section>
  </main>
</MainLayout>
